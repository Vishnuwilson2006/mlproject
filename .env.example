# Vercel Environment Variables Template
# Copy this to your Vercel project settings and fill in the values

# Django Secret Key (generate a strong one)
SECRET_KEY=your-secret-key-here

# Debug mode (set to False in production)
DEBUG=False

# Allowed hosts for your Vercel deployment
ALLOWED_HOSTS=your-project.vercel.app,www.your-project.vercel.app

# Database URL (if using PostgreSQL instead of SQLite)
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# Any other environment variables your app needs
